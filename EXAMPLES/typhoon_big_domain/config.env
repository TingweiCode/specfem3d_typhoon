# stop here #### 

# functions used
change_par() 
{
  # get input args
  local param=$1
  local value=$2
  local file=$3

  # locate parameter
  oldstr=`grep "^$param " $file`
  newstr="$param           =     $value"

  sed  "s?$oldstr?$newstr?g" $file  > $file.temporary
  mv $file.temporary $file
}
